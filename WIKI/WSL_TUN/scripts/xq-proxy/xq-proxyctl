#!/usr/bin/python3
"""WSL-wide TUN controller. Root-owned when installed; only owns xq resources."""
import base64
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import pwd
import re
import socket
import stat
import struct
import subprocess
import sys
import syslog
import tempfile
import time

STATE = Path('/var/lib/xq-proxy')
ENABLED = STATE / 'enabled'
STATEFILE = STATE / 'state.json'
CONF = Path('/etc/xq-proxy/sing-box.json')
RESOLV = Path('/etc/resolv.conf')
USER = 'xq-proxy'
SERVICE = 'xq-proxy.service'
TUN = 'xq-tun'
TABLE = '20260'
PRIORITIES = (18400, 18401, 18402)
PORT = 4066
SUBNET = ipaddress.ip_network('172.30.255.0/30')
TUN_DNS = '172.30.255.2'
DNS_HEADER = '# Managed by xq-proxy while ON; OFF restores the original.'
WSL_RESOLV = Path('/mnt/wsl/resolv.conf')
DNS_LISTEN = '127.0.0.1'
DNS_PORT = 1053
DNS_ZONE = 20262
DNS_MARK = 0x02000000
DNS_BIT = DNS_MARK
CONNTRACK = '/usr/sbin/conntrack'
CORE = Path('/usr/bin/sing-box')
# SOCKS5 greeting run as the dedicated account. Exit 3: no connection or no reply;
# exit 4: the port answered, but not as a no-authentication SOCKS5 server.
SOCKS_PROBE = '''import socket, sys
try:
    connection = socket.create_connection(({host!r}, {port}), timeout=4)
    connection.settimeout(4)
    connection.sendall(bytes([5, 1, 0]))
    reply = connection.recv(2)
    connection.close()
except OSError as exc:
    print(type(exc).__name__ + ": " + str(exc), file=sys.stderr)
    sys.exit(3)
if reply != bytes([5, 0]):
    print("unexpected SOCKS5 reply " + (reply.hex() or "(connection closed)"), file=sys.stderr)
    sys.exit(4)
'''


def event(message, priority=syslog.LOG_INFO):
    """Record control transitions, never users' DNS questions or payloads."""
    try:
        syslog.openlog('xq-proxyctl', syslog.LOG_PID, syslog.LOG_DAEMON)
        syslog.syslog(priority, message.replace('\n', ' | ')[:1200])
    except OSError:
        pass


def run(args, *, check=True, data=None):
    r = subprocess.run(args, input=data, text=True, capture_output=True, timeout=35)
    if check and r.returncode:
        raise RuntimeError(' '.join(args) + ': ' + r.stderr.strip())
    return r


def atomic(path, data, mode=0o600):
    path = Path(path)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data if isinstance(data, bytes) else data.encode())
            f.flush()
            os.fsync(f.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.lexists(name):
            os.unlink(name)


def load():
    return json.loads(STATEFILE.read_text()) if STATEFILE.exists() else {}


def save(s):
    atomic(STATEFILE, json.dumps(s, indent=2) + '\n')


def resolver_snapshot():
    if RESOLV.is_symlink():
        return {'kind': 'symlink', 'target': os.readlink(RESOLV)}
    if RESOLV.exists():
        return {'kind': 'file', 'mode': stat.S_IMODE(RESOLV.stat().st_mode),
                'data': base64.b64encode(RESOLV.read_bytes()).decode()}
    return {'kind': 'absent'}


def nameservers(data):
    result = []
    for line in data.decode(errors='replace').splitlines():
        fields = line.split('#', 1)[0].split()
        if len(fields) >= 2 and fields[0] == 'nameserver':
            result.append(fields[1])
    return result


def managed_dns(data):
    return DNS_HEADER.encode() in data or TUN_DNS in nameservers(data)


def current_dns_managed():
    try:
        return managed_dns(RESOLV.read_bytes())
    except OSError:
        return False


def safe_snapshot(snapshot):
    """Validate restorability without resolving through our own resolver entry."""
    try:
        kind = snapshot['kind']
        if kind == 'absent':
            return True
        if kind == 'file':
            mode = snapshot['mode']
            return (isinstance(mode, int) and 0 <= mode <= 0o7777
                    and not managed_dns(base64.b64decode(snapshot['data'], validate=True)))
        if kind == 'symlink':
            literal = snapshot['target']
            if not isinstance(literal, str) or not literal:
                return False
            target = Path(literal)
            if not target.is_absolute():
                target = RESOLV.parent / target
            forbidden = RESOLV.parent.resolve() / RESOLV.name
            seen = set()
            for _ in range(40):
                target = Path(os.path.abspath(target))
                target = target.parent.resolve(strict=True) / target.name
                if target == forbidden or target in seen:
                    return False
                seen.add(target)
                if not target.is_symlink():
                    return target.is_file() and not managed_dns(target.read_bytes())
                link = Path(os.readlink(target))
                target = link if link.is_absolute() else target.parent / link
        return False
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        return False


def recovery_snapshot(s):
    saved = s.get('resolver_before')
    if safe_snapshot(saved):
        return saved
    # Use only the verified WSL-provided file; never guess a public DNS resolver.
    if WSL_RESOLV.is_file() and not WSL_RESOLV.is_symlink():
        data = WSL_RESOLV.read_bytes()
        servers = nameservers(data)
        try:
            valid_servers = bool(servers) and all(ipaddress.ip_address(x) for x in servers)
        except ValueError:
            valid_servers = False
        if valid_servers and not managed_dns(data):
            candidate = {'kind': 'symlink', 'target': str(WSL_RESOLV)}
            if safe_snapshot(candidate):
                return candidate
    raise RuntimeError('原 DNS 备份无效，且无法核实 WSL 原 DNS；保留保护规则，拒绝误恢复 TUN DNS')


def refreshed_baseline(s):
    """Baseline for a resolver this controller does not manage; never a reason to fail."""
    try:
        return recovery_snapshot(s)
    except (RuntimeError, OSError):
        pass
    # Nothing verifiable is saved: record the resolver actually in use, if that is safe.
    try:
        current = resolver_snapshot()
    except OSError:
        return None
    return current if safe_snapshot(current) else None


def restore_resolver(snapshot):
    if not safe_snapshot(snapshot):
        raise RuntimeError('拒绝恢复无效或指向 TUN 自身的 DNS 备份')
    if snapshot['kind'] == 'symlink':
        temp = RESOLV.parent / ('.xq-resolv-' + str(os.getpid()))
        try:
            os.symlink(snapshot['target'], temp)
            os.replace(temp, RESOLV)
        finally:
            if os.path.lexists(temp):
                temp.unlink()
    elif snapshot['kind'] == 'file':
        atomic(RESOLV, base64.b64decode(snapshot['data']), snapshot['mode'])
    elif snapshot['kind'] == 'absent' and os.path.lexists(RESOLV):
        RESOLV.unlink()


def gateway():
    routes = json.loads(run(['ip', '-j', '-4', 'route', 'show', 'table', 'main', 'default']).stdout)
    routes = [r for r in routes if r.get('gateway') and r.get('dev') != TUN]
    if not routes:
        raise RuntimeError('No physical IPv4 default gateway')
    r = min(routes, key=lambda x: x.get('metric', 0))
    return str(ipaddress.IPv4Address(r['gateway'])), r['dev']


def guard_text(s, dns_active=True):
    # Only the dedicated core may use the Windows SOCKS transport. No established bypass.
    # Keep zone classification during shutdown so old mappings can be identified
    # and removed while the independent output guard remains in place.
    # During OFF, stop new DNS flows before conntrack, including null-NAT
    # bindings that could otherwise survive in our zone into the next ON.
    stopping = '' if dns_active else f'''
        meta skuid != {s['uid']} meta nfproto ipv4 meta l4proto {{ tcp, udp }} th dport 53 counter reject with icmpx type admin-prohibited
        meta skuid != {s['uid']} ip daddr {DNS_LISTEN} meta l4proto {{ tcp, udp }} th dport {DNS_PORT} counter reject with icmpx type admin-prohibited
'''
    nat = f'''
      chain dns_nat_output {{
        type nat hook output priority -100; policy accept;
        ct direction reply return
        meta skuid {s['uid']} return
        ct zone != {DNS_ZONE} return
        ip daddr {DNS_LISTEN} meta l4proto {{ tcp, udp }} th dport {DNS_PORT} ct mark set ct mark | {DNS_MARK:#x} return
        meta nfproto ipv4 meta l4proto {{ tcp, udp }} th dport 53 ct mark set ct mark | {DNS_MARK:#x} dnat ip to {DNS_LISTEN}:{DNS_PORT}
      }}
''' if dns_active else ''
    return f'''table inet xq_proxy {{
      chain dns_zone_output {{
        type filter hook output priority raw; policy accept;
{stopping}
        meta skuid != {s['uid']} meta nfproto ipv4 meta l4proto {{ tcp, udp }} th dport 53 ct zone set {DNS_ZONE}
        meta skuid != {s['uid']} ip daddr {DNS_LISTEN} meta l4proto {{ tcp, udp }} th dport {DNS_PORT} ct zone set {DNS_ZONE}
        ip saddr {DNS_LISTEN} meta l4proto {{ tcp, udp }} th sport {DNS_PORT} ct zone set {DNS_ZONE}
        ip saddr {DNS_LISTEN} icmp type destination-unreachable @th,240,16 {DNS_PORT} ct zone set {DNS_ZONE}
      }}
{nat}
      chain output {{
        type filter hook output priority -10; policy drop;
        oifname "lo" ip saddr {DNS_LISTEN} meta l4proto {{ tcp, udp }} th sport {DNS_PORT} ct zone {DNS_ZONE} ct mark & {DNS_MARK:#x} != 0 ct direction reply counter accept
        meta l4proto {{ tcp, udp }} th dport 53 oifname != "{TUN}" counter reject with icmpx type admin-prohibited
        oifname "lo" counter accept
        meta nfproto ipv4 oifname "{TUN}" counter accept
        meta skuid {s['uid']} ip daddr {s['host']} tcp dport {PORT} counter accept
        meta skuid {s['uid']} ip daddr {s['host']} meta l4proto udp counter accept
        counter reject with icmpx type admin-prohibited
      }}
      chain forward {{
        type filter hook forward priority -10; policy drop;
        meta nfproto ipv4 oifname "{TUN}" counter accept
        meta nfproto ipv4 iifname "{TUN}" ct state established,related counter accept
        counter reject with icmpx type admin-prohibited
      }}
    }}\n'''


def firewall_digest():
    text = run(['nft', '--stateless', 'list', 'table', 'inet', 'xq_proxy']).stdout
    return hashlib.sha256(text.encode()).hexdigest()


def install_guard(s, dns_active=True):
    exists = run(['nft', 'list', 'table', 'inet', 'xq_proxy'], check=False).returncode == 0
    text = ('delete table inet xq_proxy\n' if exists else '') + guard_text(s, dns_active)
    run(['nft', '--check', '-f', '-'], data=text)
    run(['nft', '-f', '-'], data=text)
    s.update(guard_digest=firewall_digest(), dns_active=dns_active,
             dns_zone=DNS_ZONE, dns_mark=DNS_MARK)


def require_conntrack():
    if not os.path.isfile(CONNTRACK) or not os.access(CONNTRACK, os.X_OK):
        raise RuntimeError('需要安装 conntrack，才能精确清理本功能的 DNS 映射；未改变网络')


def delete_dns_connections():
    require_conntrack()
    result = run([CONNTRACK, '-D', '-f', 'ipv4', '--zone', str(DNS_ZONE),
                  '--mark', f'{DNS_MARK:#x}/{DNS_MARK:#x}'], check=False)
    # conntrack returns 1 when no matching entries exist.
    if result.returncode not in (0, 1) or (result.returncode == 1 and
            '0 flow entries have been deleted' not in result.stderr):
        raise RuntimeError('清理本功能 DNS conntrack 失败；guard 保留：' + result.stderr.strip())


def check_dns_reservations(s):
    """Fail before mutation when ownership of the DNS tracking space is unclear."""
    require_conntrack()
    ruleset = json.loads(run(['nft', '-j', 'list', 'ruleset']).stdout)
    def tracking_reference(value):
        if isinstance(value, dict):
            if value.get('ct', {}).get('key') in ('zone', 'mark'):
                return True
            return any(tracking_reference(v) for v in value.values())
        return isinstance(value, list) and any(tracking_reference(v) for v in value)
    for item in ruleset.get('nftables', []):
        rule = item.get('rule', {})
        if rule.get('family') == 'inet' and rule.get('table') == 'xq_proxy':
            continue
        # Arbitrary masks/maps can overwrite our bit or select our zone. Do not
        # guess that an existing tracking policy is disjoint merely by its name.
        if tracking_reference(rule.get('expr', [])):
            raise RuntimeError('其他 nft 表使用 conntrack mark/zone，无法确认 DNS zone 20262 和标记 0x02000000 无冲突；拒绝覆盖')
    result = run([CONNTRACK, '-L', '-f', 'ipv4', '--zone', str(DNS_ZONE)], check=False)
    if result.returncode != 0:
        raise RuntimeError('无法检查 DNS conntrack zone：' + result.stderr.strip())
    entries = [line for line in result.stdout.splitlines() if line.strip()]
    owns_zone = s.get('dns_zone') == DNS_ZONE and s.get('dns_mark') == DNS_MARK
    if entries and not owns_zone:
        raise RuntimeError('DNS conntrack zone 20262 已被占用，拒绝启用')
    for line in entries:
        mark = next((part[5:] for part in line.split() if part.startswith('mark=')), '0')
        if not int(mark, 0) & DNS_MARK:
            raise RuntimeError('DNS conntrack zone 20262 存在非本功能标记的连接，拒绝启用')


def file_digest(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def dns_listening():
    """Check both transports and the exact loopback bind, without public I/O."""
    for transport in ('-t', '-u'):
        result = run(['ss', '-H', '-l', '-n', transport, 'sport', '=', f':{DNS_PORT}'], check=False)
        if result.returncode or not any(f'{DNS_LISTEN}:{DNS_PORT}' in line.split()
                                        for line in result.stdout.splitlines()):
            return False
    return True


def dns_probe(timeout=4):
    """Bound the complete UDP probe across the default IPv4 DNS servers."""
    servers = nameservers(RESOLV.read_bytes())
    deadline = time.monotonic() + timeout
    failures = []
    query_id = os.urandom(2)
    question = b'\x07example\x03com\x00\x00\x01\x00\x01'
    packet = query_id + struct.pack('!HHHHH', 0x0100, 1, 0, 0, 0) + question
    ipv4 = [server for server in servers if ipaddress.ip_address(server).version == 4]
    if not ipv4:
        return False, '默认 resolver 没有 IPv4 DNS（IPv6 仍按策略阻断）'
    for server in ipv4:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as connection:
                connection.settimeout(remaining / max(1, len(ipv4) - len(failures)))
                connection.connect((server, 53))
                connection.send(packet)
                answer = connection.recv(4096)
                if len(answer) < 12 or answer[:2] != query_id:
                    raise RuntimeError('DNS 响应 ID/长度不匹配')
                flags, questions, answers = struct.unpack('!HHH', answer[2:8])
                if not flags & 0x8000 or flags & 0x0200 or flags & 0x000f or questions != 1 or not answers:
                    raise RuntimeError('DNS 响应未返回成功答案')
                return True, f'成功（默认 DNS {server}，example.com A）'
        except (OSError, RuntimeError) as exc:
            failures.append(f'{server}: {exc}')
    return False, '; '.join(failures) or '默认 DNS 探测超时'


def config(s):
    return {
        'log': {'level': 'warn', 'timestamp': True},
        'dns': {'servers': [{'type': 'https', 'tag': 'proxied-dns', 'server': '1.1.1.1',
            'server_port': 443, 'path': '/dns-query',
            'tls': {'enabled': True, 'server_name': 'cloudflare-dns.com'}, 'detour': 'karing'}],
            'final': 'proxied-dns', 'strategy': 'ipv4_only'},
        'inbounds': [{'type': 'tun', 'tag': 'tun-in', 'interface_name': TUN,
            'address': ['172.30.255.1/30'], 'mtu': 1280, 'auto_route': False,
            'dns_mode': 'disabled', 'stack': 'gvisor'},
            {'type': 'direct', 'tag': 'dns-in', 'listen': DNS_LISTEN, 'listen_port': DNS_PORT}],
        'outbounds': [{'type': 'socks', 'tag': 'karing', 'server': s['host'],
            'server_port': PORT, 'version': '5', 'bind_interface': s['interface']}],
        'route': {'rules': [{'inbound': 'dns-in', 'action': 'hijack-dns'},
                            {'inbound': 'tun-in', 'port': 53, 'action': 'hijack-dns'}],
            'final': 'karing'},
    }


def config_text(s):
    return json.dumps(config(s), indent=2) + '\n'


def check_candidate_config(s):
    """Let the core judge the configuration this ON would install, without installing it."""
    directory = CONF.parent if CONF.parent.is_dir() else None
    descriptor, name = tempfile.mkstemp(prefix='.' + CONF.name + '-', dir=directory)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(config_text(s))
        result = run([str(CORE), 'check', '-c', name], check=False)
    finally:
        os.unlink(name)
    if result.returncode:
        # sing-box colors its message even on a pipe, and names the candidate that is gone by now.
        detail = re.sub(r'\x1b\[[0-9;]*m', '', result.stderr).strip()
        detail = detail.replace(name, '<待安装的 ' + CONF.name + '>')
        raise RuntimeError('代理核心配置未通过 sing-box check：' + (detail or f'exit {result.returncode}'))


def preflight(s):
    """SOCKS5 greeting to Karing as the dedicated UID, which an installed guard allows."""
    probe = SOCKS_PROBE.format(host=s['host'], port=PORT)
    result = run(['runuser', '-u', USER, '--', '/usr/bin/python3', '-c', probe], check=False)
    detail = result.stderr.strip()
    if result.returncode in (3, 4):
        raise RuntimeError(f'Karing {s["host"]}:{PORT} SOCKS5 握手失败：'
                           + (detail.splitlines() or ['无错误输出'])[-1])
    if result.returncode:
        raise RuntimeError(f'无法以 {USER} 身份执行 Karing 握手检查：'
                           + (detail or f'exit {result.returncode}'))


def check_dns_port():
    listeners = run(['ss', '-H', '-l', '-n', '-t', '-u', '-p',
                     'sport', '=', f':{DNS_PORT}']).stdout.splitlines()
    pid = run(['systemctl', 'show', '--property=MainPID', '--value', SERVICE]).stdout.strip()
    if any(not pid.isdigit() or pid == '0' or f'pid={pid},' not in line for line in listeners):
        raise RuntimeError('DNS 端口 1053 已被其他进程占用，拒绝启用')


def remove_routes():
    for family in ('-4', '-6'):
        for priority in PRIORITIES:
            # Only these reserved priorities are used by this controller.
            while run(['ip', family, 'rule', 'del', 'pref', str(priority)], check=False).returncode == 0:
                pass
        run(['ip', family, 'route', 'flush', 'table', TABLE], check=False)


def attach():
    if not ENABLED.exists():
        raise RuntimeError('Proxy mode is OFF')
    s = load()
    # A guard must exist before routing changes. WSL owns resolv.conf.
    run(['nft', 'list', 'table', 'inet', 'xq_proxy'])
    for _ in range(50):
        if run(['ip', 'link', 'show', TUN], check=False).returncode == 0:
            break
        time.sleep(0.1)
    else:
        raise RuntimeError('TUN interface did not appear; guard retained')
    remove_routes()
    run(['ip', '-4', 'route', 'replace', 'default', 'dev', TUN, 'table', TABLE])
    run(['ip', '-4', 'rule', 'add', 'pref', str(PRIORITIES[0]), 'iif', TUN, 'lookup', 'main'])
    run(['ip', '-4', 'rule', 'add', 'pref', str(PRIORITIES[1]),
         'uidrange', f"{s['uid']}-{s['uid']}", 'lookup', 'main'])
    run(['ip', '-4', 'rule', 'add', 'pref', str(PRIORITIES[2]), 'lookup', TABLE])
    # Unsupported IPv6 is explicitly unreachable, never silently sent to the physical interface.
    run(['ip', '-6', 'route', 'replace', 'unreachable', 'default', 'table', TABLE])
    run(['ip', '-6', 'rule', 'add', 'pref', str(PRIORITIES[2]), 'lookup', TABLE])
    for _ in range(30):
        if dns_listening():
            break
        time.sleep(0.1)
    else:
        raise RuntimeError('本地 DNS TCP/UDP 1053 未监听；guard 保留')
    s['phase'] = 'active'
    s['running_config_digest'] = file_digest(CONF)
    s['running_core_digest'] = file_digest(CORE)
    save(s)
    event('attach completed: TUN routes and local DNS TCP/UDP 1053 ready; resolver unchanged')


def planned_state(s, was_on):
    """Read-only: the state this ON will record, or the reason it cannot go on."""
    host, interface = gateway()
    if not was_on:
        for family in ('-4', '-6'):
            rules = json.loads(run(['ip', '-j', family, 'rule', 'show']).stdout)
            if any(r.get('priority') in PRIORITIES for r in rules):
                raise RuntimeError('Reserved policy routing priority is already in use')
            routes = run(['ip', family, 'route', 'show', 'table', TABLE], check=False).stdout.strip()
            if routes:
                raise RuntimeError('Reserved routing table is already in use')
        routes = json.loads(run(['ip', '-j', '-4', 'route', 'show', 'table', 'main']).stdout)
        for r in routes:
            dst = r.get('dst', 'default')
            if dst != 'default' and ipaddress.ip_network(dst, strict=False).overlaps(SUBNET):
                raise RuntimeError('TUN subnet overlaps an existing route')
        original_dns = recovery_snapshot(s) if current_dns_managed() else resolver_snapshot()
        if not safe_snapshot(original_dns):
            raise RuntimeError('当前 DNS 无法安全备份，拒绝开启代理')
        s = {'resolver_before': original_dns, 'activated_at': time.time()}
    elif current_dns_managed():
        # A real migration of the legacy TUN resolver needs a verified baseline:
        # refuse rather than restore a wrong DNS. The guard is already re-applied.
        s['resolver_before'] = recovery_snapshot(s)
    else:
        # A resolver that is not ours is never rewritten, so an obsolete baseline
        # cannot block this ON; replace it only when something verifiable exists.
        baseline = refreshed_baseline(s)
        if baseline is not None:
            s['resolver_before'] = baseline
    try:
        account = pwd.getpwnam(USER)
    except KeyError:
        raise RuntimeError(f'专用账号 {USER} 不存在') from None
    s.update(host=host, interface=interface, uid=account.pw_uid, port=PORT)
    return s


def refusal(exc):
    """A failure before the first change says so: the clean OFF is exactly as it was."""
    cause = str(exc) if isinstance(exc, RuntimeError) else f'{type(exc).__name__}: {exc}'
    return RuntimeError(cause if cause.endswith('未改变网络') else cause + '；未改变网络')


def on():
    s = load()
    was_on = ENABLED.exists()
    previous_endpoint = (s.get('host'), s.get('interface'), s.get('uid'))
    # A clean OFF has no protection to lose, so everything that can refuse this ON,
    # Karing and the core configuration included, is proven before the first change.
    # An ON marker or any residue keeps the guard-first order below: protection goes
    # up, or stays up, before anything that may fail, and a failure never removes it.
    clean = not was_on and not off_residue()
    if clean:
        try:
            check_dns_reservations(s)
            check_dns_port()
            issues = resolver_issues()
            if issues:
                raise RuntimeError('；'.join(issues))
            s = planned_state(s, was_on)
            preflight(s)
            check_candidate_config(s)
        except Exception as exc:
            raise refusal(exc) from exc
    else:
        # Dependencies and resource conflicts are checked before changing a running
        # installation; in particular, OFF must always be able to clear DNS NAT.
        check_dns_reservations(s)
        check_dns_port()
        # On repeated ON, restore the saved guard before an operation that may fail or wait.
        if was_on:
            install_guard(s)
            save(s)
            atomic(Path('/run/xq-proxy-enabled'), 'on\n', 0o644)
        s = planned_state(s, was_on)
    # From here on the network changes. With a marker or residue this is the retry
    # path: the guard is installed even while the upstream is still unavailable.
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    save(s)
    atomic(ENABLED, 'on\n')
    install_guard(s)
    save(s)
    atomic(Path('/run/xq-proxy-enabled'), 'on\n', 0o644)
    if not clean:
        preflight(s)
    CONF.parent.mkdir(mode=0o755, exist_ok=True)
    atomic(CONF, config_text(s), 0o644)
    if not clean:
        # The clean path installs exactly the candidate the core has already approved.
        run([str(CORE), 'check', '-c', str(CONF)])
    # During migration, put back the validated resolver baseline once. New
    # sessions may replace this WSL symlink freely; DNS interception is in nft.
    if current_dns_managed():
        restore_resolver(s['resolver_before'])
    healthy = (was_on and previous_endpoint == (s['host'], s['interface'], s['uid'])
        and not configuration_issues(s))
    if not healthy:
        run(['systemctl', 'restart', SERVICE])
    result = status()
    event('on completed: ' + ('configuration and default DNS healthy' if result == 0 else
                              'health check failed; direct-traffic guard retained'),
          syslog.LOG_INFO if result == 0 else syslog.LOG_WARNING)
    return result


def off(*, from_boot=False):
    s = load()
    guard_exists = run(['nft', 'list', 'table', 'inet', 'xq_proxy'], check=False).returncode == 0
    legacy_dns = current_dns_managed()
    cleanup = ENABLED.exists() or guard_exists or legacy_dns
    uses_dns_nat = s.get('dns_zone') == DNS_ZONE and s.get('dns_mark') == DNS_MARK
    if uses_dns_nat and (cleanup or s.get('phase') != 'off'):
        require_conntrack()
    # Only the legacy TUN resolver is ever restored. Find its safe baseline before
    # stopping a working core or removing protection; a resolver that is not ours
    # is left alone, so an obsolete baseline must not block this OFF.
    snapshot = recovery_snapshot(s) if legacy_dns else None
    # A boot reset must not stop the unit that is currently running this command.
    if not from_boot:
        run(['systemctl', 'stop', 'xq-proxy-boot.service'], check=False)
    if uses_dns_nat and guard_exists:
        # Keep replies/classification and the independent guard, but reject new
        # DNS flows before conntrack and stop creating fresh NAT bindings.
        install_guard(s, dns_active=False)
    if cleanup:
        ENABLED.unlink(missing_ok=True)
        s['phase'] = 'disabling'
        save(s)
    # Stop retries first; retain the independent guard until DNS and routes are restored.
    run(['systemctl', 'stop', SERVICE])
    if uses_dns_nat and (cleanup or s.get('phase') != 'off'):
        delete_dns_connections()
    stale_routes = bool(s) and any(owned_rule(r, s) for family in ('-4', '-6')
                                  for r in json_result(['ip', '-j', family, 'rule', 'show']))
    if cleanup or stale_routes:
        remove_routes()
    if legacy_dns and current_dns_managed():
        restore_resolver(snapshot)
        s['resolver_before'] = snapshot
    if guard_exists:
        run(['nft', 'delete', 'table', 'inet', 'xq_proxy'])
    ENABLED.unlink(missing_ok=True)
    Path('/run/xq-proxy-enabled').unlink(missing_ok=True)
    if s:
        s['phase'] = 'off'
        s['dns_active'] = False
        save(s)
    result = status()
    event(('boot-off' if from_boot else 'off') + ' completed: ' +
          ('owned DNS mappings, routes and guard removed' if result == 0 else 'residual configuration detected'),
          syslog.LOG_INFO if result == 0 else syslog.LOG_WARNING)
    return result


def json_result(args):
    r = run(args, check=False)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []


def owned_rule(r, s):
    priority = r.get('priority')
    table = str(r.get('table'))
    return ((priority == PRIORITIES[0] and r.get('iif') == TUN and table in ('main', '254'))
            or (priority == PRIORITIES[1] and s.get('uid') is not None
                and r.get('uid_start') == s['uid'] and r.get('uid_end') == s['uid']
                and table in ('main', '254'))
            or (priority == PRIORITIES[2] and table == TABLE))


def route_issues(s):
    issues = []
    rules4 = json_result(['ip', '-j', '-4', 'rule', 'show'])
    rules6 = json_result(['ip', '-j', '-6', 'rule', 'show'])
    main = lambda r: str(r.get('table')) in ('main', '254')
    def unconstrained(r, allowed):
        # A rule with the right priority but extra selectors does not cover all intended traffic.
        selector_keys = {'iif', 'oif', 'uid_start', 'uid_end', 'fwmark', 'fwmask',
                         'ipproto', 'sport', 'dport', 'tos', 'goto', 'not', 'l3mdev'}
        return (r.get('src', 'all') == 'all' and r.get('dst', 'all') == 'all'
                and not ((selector_keys & r.keys()) - allowed))
    expected = (
        (rules4, PRIORITIES[0], lambda r: r.get('iif') == TUN and main(r)
         and unconstrained(r, {'iif'}), 'TUN 返回路由规则'),
        (rules4, PRIORITIES[1], lambda r: r.get('uid_start') == s.get('uid')
         and r.get('uid_end') == s.get('uid') and s.get('uid') is not None and main(r)
         and unconstrained(r, {'uid_start', 'uid_end'}), '代理用户路由规则'),
        (rules4, PRIORITIES[2], lambda r: str(r.get('table')) == TABLE
         and unconstrained(r, set()), 'IPv4 TUN 路由规则'),
        (rules6, PRIORITIES[2], lambda r: str(r.get('table')) == TABLE
         and unconstrained(r, set()), 'IPv6 阻断路由规则'),
    )
    for rules, priority, matches, label in expected:
        found = [r for r in rules if r.get('priority') == priority]
        if len(found) != 1 or not matches(found[0]):
            issues.append(label + '缺失或不匹配')
    routes4 = json_result(['ip', '-j', '-4', 'route', 'show', 'table', TABLE])
    routes6 = json_result(['ip', '-j', '-6', 'route', 'show', 'table', TABLE])
    if not any(r.get('dst') == 'default' and r.get('dev') == TUN
               and 'linkdown' not in r.get('flags', []) for r in routes4):
        issues.append('IPv4 默认路由未正确指向 TUN')
    if not any(r.get('dst') == 'default' and r.get('type') == 'unreachable' for r in routes6):
        issues.append('IPv6 不可达路由缺失')
    return issues


def resolver_issues():
    """The default resolver as ON needs it: readable, an IPv4 server, not the legacy one."""
    issues = []
    try:
        servers = nameservers(RESOLV.read_bytes())
        if not servers or not any(ipaddress.ip_address(server).version == 4 for server in servers):
            issues.append('默认 resolver 缺少 IPv4 DNS（IPv6 仍按策略阻断）')
        if current_dns_managed():
            issues.append('仍残留旧版 TUN resolver；需要迁移回原 DNS')
    except (OSError, ValueError):
        issues.append('DNS 配置不可读取')
    return issues


def off_residue(*, core=None, guard=None):
    """What a clean OFF must not have. status reports it; ON keeps its guard-first order over it."""
    if core is None:
        core = run(['systemctl', 'is-active', '--quiet', SERVICE], check=False).returncode == 0
    if guard is None:
        guard = run(['nft', 'list', 'table', 'inet', 'xq_proxy'], check=False).returncode == 0
    issues = []
    if core or guard or current_dns_managed():
        issues.append('OFF 状态仍有代理核心、防火墙或 TUN DNS 残留')
    for family in ('-4', '-6'):
        rules = json_result(['ip', '-j', family, 'rule', 'show'])
        if any(r.get('priority') in PRIORITIES for r in rules):
            issues.append(f'OFF 状态仍有 {family} 策略路由残留')
    return issues


def configuration_issues(s, *, core=None, guard=None):
    issues = []
    if core is None:
        core = run(['systemctl', 'is-active', '--quiet', SERVICE], check=False).returncode == 0
    if guard is None:
        guard = run(['nft', 'list', 'table', 'inet', 'xq_proxy'], check=False).returncode == 0
    if not core:
        issues.append('代理核心未运行')
    if not guard:
        issues.append('防直连规则表缺失')
    elif not s.get('dns_active') or s.get('guard_digest') != firewall_digest():
        issues.append('DNS 接管或防直连规则与已安装摘要不匹配')
    links = json_result(['ip', '-j', 'link', 'show', TUN])
    if not any('UP' in link.get('flags', []) for link in links):
        issues.append('TUN 接口不存在或未启用')
    issues.extend(route_issues(s))
    issues.extend(resolver_issues())
    if not dns_listening():
        issues.append('本地 DNS TCP/UDP 1053 监听不完整')
    if not os.access(CONNTRACK, os.X_OK):
        issues.append('缺少 conntrack，无法安全关闭 DNS 接管')
    try:
        if json.loads(CONF.read_text()) != config(s):
            issues.append('代理核心配置偏离预期')
        if s.get('running_config_digest') != file_digest(CONF):
            issues.append('当前核心尚未加载最新配置')
        if s.get('running_core_digest') != file_digest(CORE):
            issues.append('代理核心二进制已变化，需要重启加载')
    except (OSError, ValueError, KeyError):
        issues.append('代理核心配置或二进制不可检查')
    # The baseline is only ever used to migrate a legacy TUN resolver.
    if current_dns_managed() and not safe_snapshot(s.get('resolver_before')):
        issues.append('原 DNS 恢复备份不可用')
    try:
        host, interface = gateway()
        if s.get('host') != host or s.get('interface') != interface:
            issues.append('代理上游与当前 Windows 网关或网卡不一致')
    except RuntimeError:
        issues.append('物理默认网关不可用')
    return issues


def status():
    s = load()
    enabled = ENABLED.exists()
    core = run(['systemctl', 'is-active', '--quiet', SERVICE], check=False).returncode == 0
    guard = run(['nft', 'list', 'table', 'inet', 'xq_proxy'], check=False).returncode == 0
    issues = (configuration_issues(s, core=core, guard=guard) if enabled else
              off_residue(core=core, guard=guard))
    print('代理状态：' + ('已开启（WSL 全流量）' if enabled and not issues else
          'ON，但配置异常' if enabled else
          'OFF，但存在残留配置' if issues else '已关闭（恢复原网络）'))
    try:
        host, interface = gateway()
        addrs = json.loads(run(['ip', '-j', '-4', 'addr', 'show', 'dev', interface]).stdout)
        local = next(a['local'] for item in addrs for a in item.get('addr_info', []) if a['family'] == 'inet')
        print('当前 WSL IP：' + local)
        print('Windows 宿主机 IP（WSL 网关）：' + host)
    except (RuntimeError, StopIteration):
        pass
    print(('代理 IP：' if enabled else '原代理 IP：') + s.get('host', '未设置'))
    print('代理端口：' + str(s.get('port', PORT)))
    if enabled:
        print('防直连：' + ('已开启' if guard else '缺失'))
        print('DNS 接管：应用 IPv4 TCP/UDP 53 → 127.0.0.1:1053 → 代理 DoH；WSL 继续管理 resolver')
        print('配置检查：' + ('异常' if issues else 'DNS 入口、接管规则、路由和运行版本正常'))
    for issue in issues:
        print('检查异常：' + issue)
    if issues:
        print('建议执行：' + ('xq_proxyon 重新应用配置，或 xq_proxyoff 恢复普通网络' if enabled else
                            'xq_proxyoff 清理残留配置'))
    dns_ok = True
    if enabled and not issues:
        try:
            dns_ok, detail = dns_probe(timeout=4)
        except (OSError, ValueError) as exc:
            dns_ok, detail = False, str(exc)
        print('默认 DNS 连通性：' + detail)
        if not dns_ok:
            event('default DNS health probe failed: ' + detail, syslog.LOG_WARNING)
            print('配置完整，但默认 DNS 探测失败；请检查上游和服务日志。')
    elif enabled:
        print('默认 DNS 连通性：未探测（先修复配置异常）')
    return 1 if issues or not dns_ok else 0


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Use sudo xq-proxyctl on|off|status')
    action = sys.argv[1] if len(sys.argv) == 2 else ''
    if action not in ('on', 'off', 'status', 'attach', 'boot-off'):
        raise RuntimeError('Usage: xq-proxyctl on|off|status')
    # attach is called by systemd while on() waits for service readiness.
    if action == 'attach':
        attach()
        return
    with open('/run/lock/xq-proxy.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == 'boot-off':
            return off(from_boot=True)
        else:
            return {'on': on, 'off': off, 'status': status}[action]()


if __name__ == '__main__':
    try:
        sys.exit(main() or 0)
    except Exception as exc:
        event('controller failed: ' + str(exc), syslog.LOG_ERR)
        print('xq-proxy: ' + str(exc), file=sys.stderr)
        if ENABLED.exists():
            print('未自动回退直连。恢复原网络请执行 sudo xq-proxyctl off。', file=sys.stderr)
        sys.exit(1)

# 【已脱敏的入库副本】名字以 TOKEN / SECRET / PASSWORD / API_KEY 结尾的项，值已替换为 "xxxxxx"。
# 真实值只在部署机工作目录的 .env 里；用本文件部署前必须先填回真实值，
# 尤其是 AUTH_SECRET：填错会让已有账号的密码全部失效。

# MoeMail 部署配置
# 只需要填写标了【必填】的项，其余留空即可使用默认值。

# ---------- Cloudflare ----------
# 【必填】Cloudflare API Token（在 https://dash.cloudflare.com/profile/api-tokens 创建自定义令牌）
CLOUDFLARE_API_TOKEN = "xxxxxx"
# Account ID：可以留空，由 Claude 用上面的 token 查出来后填入
CLOUDFLARE_ACCOUNT_ID = "9618b6f624ef76051289d0af4075800d"
# 网页端访问域名，例如 mail.example.com（不带 https://）
CUSTOM_DOMAIN = "mail.7879710.xyz"
# 以下留空则使用默认值 moemail-db / moemail-kv
DATABASE_NAME = ""
KV_NAMESPACE_NAME = ""

# ---------- 登录 ----------
# 会话加密密钥，已随机生成。部署后不要再改：账号密码登录的密码哈希依赖它
AUTH_SECRET = "xxxxxx"
# GitHub 登录（可选）：OAuth App 的 Client ID / Client Secret
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
# Google 登录（可选）
AUTH_GOOGLE_ID = ""
AUTH_GOOGLE_SECRET = ""

# 站点对外地址。构建时写进页面的 canonical / 分享预览等元数据；不设置时会指向上游的 moemail.app
NEXT_PUBLIC_BASE_URL = "https://mail.7879710.xyz"
